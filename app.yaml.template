command:
  - gunicorn
  - app:app
env:
  - name: HOME
    value: /app/python/source_code
  - name: DATABRICKS_TOKEN
    valueFrom: DATABRICKS_TOKEN
  - name: ANTHROPIC_MODEL
    value: system.ai.claude-sonnet-5
  - name: PI_MODEL
    value: system.ai.claude-sonnet-5
  - name: GEMINI_MODEL
    value: system.ai.gemini-3-flash
  # These are system.ai model-service names. Setup discovers the models served
  # by this workspace and replaces unavailable requests with a compatible one.
  - name: CODEX_MODEL
    value: system.ai.gpt-5
  - name: HERMES_MODEL
    value: databricks-claude-opus-4-8
  - name: HERMES_FALLBACK_MODEL
    value: databricks-claude-opus-4-8
  - name: ENABLE_CLAUDE
    value: "true"
  # Per-CLI install toggles. Each ENABLE_* defaults to true when the variable
  # is absent, so list all of them here explicitly: an Apps overlay *replaces*
  # app.yaml rather than merging with it, and an omitted toggle silently falls
  # back to "install it".
  #
  # Set any to "false" to skip that CLI's install; the others are unaffected.
  - name: ENABLE_HERMES
    value: "true"
  - name: ENABLE_PI
    value: "true"
  - name: ENABLE_OPENCODE
    value: "true"
  # Codex and Gemini are enabled by default. Set either toggle to "false" to
  # skip that CLI when the deploying workspace does not serve its API.
  - name: ENABLE_CODEX
    value: "true"
  - name: ENABLE_GEMINI
    value: "true"
  # OPTIONAL: pin the Databricks AI Gateway for components that still consume
  # DATABRICKS_GATEWAY_HOST. The Codex, Gemini, Claude, Pi, and OpenCode setup
  # paths use workspace-origin AI Gateway routes and discover system.ai models
  # directly, so they do not require a committed gateway URL. Leave this
  # commented for portable deployments.
  #
  # Do NOT leave this uncommented with the placeholder still in it: a set value
  # is TRUSTED with no reachability probe (tier 1), so an unfilled template
  # deploys `https://<your-gateway-id>...` as the real gateway and every model
  # call fails. Also note `value: ""` means "disable the gateway", which is a
  # third behaviour distinct from unset.
  # - name: DATABRICKS_GATEWAY_HOST
  #   value: https://<your-gateway-id>.ai-gateway.<env>.cloud.databricks.com
  # NOTE: CLAUDE_CODE_DISABLE_AUTO_MEMORY=0 enables auto memory, allowing Claude Code to
  # persist context and history across sessions. This flag is temporary — once Anthropic
  # completes the rollout and auto memory is on by default, this can be removed entirely.
  - name: CLAUDE_CODE_DISABLE_AUTO_MEMORY
    value: 0
  # Set MLFLOW_TRACING_ENABLED=true to auto-trace Claude Code + Codex sessions
  # into /Users/{app_owner}/{app_name}. (Gemini/Hermes/Pi/OpenCode have no
  # first-party MLflow hook — see docs/observability.md §1.) Default off to keep
  # installs lightweight — opt in when you want per-agent trajectory traces.
  - name: MLFLOW_TRACING_ENABLED
    value: "false"
